{
  "name": "@packsmith/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data:generate": "node scripts/generate-repository-data.mjs",
    "dev": "npm run data:generate && vite",
    "typecheck": "npm run data:generate && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test:data": "node --test scripts/passport-client.test.mjs",
    "test": "npm run data:generate && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run data:generate && vitest run --coverage",
    "build": "npm run data:generate && tsc -b && vite build && node scripts/emit-route-shells.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "test:canvas": "playwright test --grep @canvas",
    "check": "npm run typecheck && npm run lint && npm run test:data && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.2.10",
    "@fontsource/archivo-black": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "gsap": "3.15.0",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "three": "0.185.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
