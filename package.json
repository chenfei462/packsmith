{
  "name": "@chenfei462/packsmith",
  "version": "0.1.0",
  "description": "Author once, validate once, build skill packs for multiple coding agents.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenfei462/packsmith.git"
  },
  "homepage": "https://github.com/chenfei462/packsmith#readme",
  "bugs": {
    "url": "https://github.com/chenfei462/packsmith/issues"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-agents",
    "agent-skills",
    "claude-code",
    "codex",
    "cli",
    "packaging",
    "prompt-engineering"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "packsmith": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test",
    "validate:example": "node src/cli.mjs validate examples/research-launchpad",
    "build:example": "node src/cli.mjs build examples/research-launchpad",
    "inspect:example": "node src/cli.mjs inspect examples/research-launchpad",
    "verification:sync": "node scripts/verification-status.mjs && node scripts/verification-status.mjs sync-readme",
    "eval": "node scripts/eval.mjs",
    "examples:check": "node scripts/examples-check.mjs",
    "smoke:example": "node scripts/smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepublishOnly": "npm test && npm run eval && npm run release:check"
  }
}
