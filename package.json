    "examples/research-launchpad/prompts/**",
    "examples/policy.json",
    "scripts/hackathon-demo.mjs",
    "scripts/verify-hackathon.mjs",
    "scripts/post-publish-verify.mjs",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
