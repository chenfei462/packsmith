  "keywords": [
    "ai-agents",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "github-copilot",
    "opencode",
    "trae",
    "cli",
    "package-manager",
    "skills",
    "supply-chain",
    "workflow",
    "prompt-engineering"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "bin": {
    "packsmith": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/pack.test.mjs tests/hackathon-demo.test.mjs tests/contract.test.mjs tests/core/skill-parser.test.mjs tests/core/diagnostics.test.mjs tests/core/workspace-missing.test.mjs tests/knowledge/loader.test.mjs tests/knowledge/runtime-facts.test.mjs tests/checks/spec.test.mjs tests/checks/spec-links.test.mjs tests/checks/activation.test.mjs tests/checks/context.test.mjs tests/checks/compatibility.test.mjs tests/checks/security.test.mjs tests/checks/doctor.test.mjs tests/checks/doctor-json-envelope.test.mjs tests/checks/doctor-faults.test.mjs tests/trigger/schema.test.mjs tests/trigger/trigger-init.test.mjs tests/runtimes/base.test.mjs tests/runtimes/codex.test.mjs tests/runtimes/claude-code.test.mjs tests/runtimes/static.test.mjs tests/runtimes/spawn.test.mjs tests/trigger/isolation.test.mjs tests/trigger/scorer.test.mjs tests/trigger/runner.test.mjs tests/trigger/trigger-run-cli.test.mjs tests/trigger/baseline.test.mjs tests/trigger/baseline-cli.test.mjs tests/trigger/matrix.test.mjs tests/trigger/regression.test.mjs tests/trigger/ci-cli.test.mjs",
    "prepublishOnly": "npm test && npm run verify:hackathon:ci && node scripts/i18n-check.mjs --ci && npm run pack:dry-run",
    "validate:example": "node src/cli.mjs validate examples/research-launchpad",
    "doctor:example": "node src/cli.mjs doctor examples/research-launchpad",
    "build:example": "node src/cli.mjs build examples/research-launchpad",
    "inspect:example": "node src/cli.mjs inspect examples/research-launchpad",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry-run": "npm publish --dry-run",
    "demo": "npm run demo:hackathon",
    "demo:hackathon": "node scripts/hackathon-demo.mjs",
    "verify:hackathon": "node scripts/verify-hackathon.mjs",
    "verify:hackathon:quick": "node scripts/verify-hackathon.mjs --quick --skip-network",
    "verify:hackathon:ci": "node scripts/verify-hackathon.mjs",
    "verify:postpublish": "node scripts/post-publish-verify.mjs",
    "smoke:example": "node src/cli.mjs init temp-smoke-pack && node src/cli.mjs validate temp-smoke-pack && node src/cli.mjs build temp-smoke-pack && node src/cli.mjs install temp-smoke-pack/dist/temp-smoke-pack --target claude-code --dest temp-installed",
    "smoke:v01": "node scripts/smoke-v01.mjs",
    "smoke:doctor:packaged": "node scripts/smoke-doctor-packaged.mjs",
    "smoke:trigger:init": "node scripts/smoke-trigger-init.mjs",
    "smoke:runtimes": "node scripts/smoke-runtimes.mjs",
    "smoke:isolation": "node scripts/smoke-isolation.mjs",
    "smoke:codex-skill-scope": "node scripts/smoke-codex-skill-scope.mjs",
    "smoke:trigger:run": "node scripts/smoke-trigger-run.mjs",
    "smoke:matrix": "node scripts/smoke-matrix.mjs",
    "smoke:baseline": "node scripts/smoke-baseline.mjs",
    "smoke:ci": "node scripts/smoke-ci.mjs",
    "test:integration": "node scripts/integration-trigger.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
