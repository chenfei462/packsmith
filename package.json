    "official-packs/context-budgeter",
    "official-packs/multi-agent-router",
    "official-packs/workflow-packager",
    "official-packs/agent-memory-curator",
    "official-packs/accessibility-auditor",
    "official-packs/api-contract-reviewer",
    "official-packs/architecture-decision-recorder",
    "official-packs/bug-reproducer",
    "official-packs/changelog-curator",
    "official-packs/ci-failure-triage",
    "official-packs/codebase-modernizer",
    "official-packs/data-pipeline-checker",
    "official-packs/database-index-advisor",
    "official-packs/dependency-risk-auditor",
    "official-packs/dependency-upgrader",
    "official-packs/frontend-state-debugger",
    "official-packs/incident-postmortem",
    "official-packs/migration-planner",
    "official-packs/onboarding-guide-writer",
    "official-packs/pr-description-writer",
    "official-packs/product-requirements-shaper",
