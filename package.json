{
  "name": "@packsmith/cli",
  "version": "1.1.0",
  "description": "Cross-agent package manager and trust gate for AI agent workflows.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenfei462/packsmith.git"
  },
  "homepage": "https://github.com/chenfei462/packsmith#readme",
  "bugs": {
    "url": "https://github.com/chenfei462/packsmith/issues"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./registry": "./registry/catalog.json",
    "./lib/*": "./src/lib/*"
  },
  "files": [
    "src",
    "registry",
    "knowledge-base",
    "official-packs/senior-code-reviewer",
