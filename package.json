    "official-packs/dependency-auditor",
    "official-packs/api-surface-mapper",
    "official-packs/database-schema-reader",
    "official-packs/legacy-code-translator",
    "official-packs/launch-researcher",
    "official-packs/github-trending-analyst",
    "official-packs/competitor-breakdown",
    "official-packs/readme-converter",
    "official-packs/roadmap-writer",
    "official-packs/issue-triage",
    "official-packs/docs-maintainer",
    "official-packs/changelog-writer",
    "official-packs/tutorial-writer",
    "official-packs/api-docs-writer",
